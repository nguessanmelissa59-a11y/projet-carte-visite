PORT=3000
HOST=0.0.0.0
# E-mails bootstrap admin (CSV, case-insensitive). Obligatoire pour activer /admin.
ADMIN_EMAILS=toi@exemple.com
# Copier ce fichier en ".env" (jamais envoye sur Git), puis relancer npm start.

# Envoi des codes par e-mail (Gmail). SMTP_PASS = mot de passe d'application Google
# (16 lettres, compte Google > Securite > Validation en deux etapes > Mots de passe
# des applications), pas le mot de passe habituel du compte.
# SMTP_USER=votre.adresse@gmail.com
# SMTP_PASS=
# Facultatif (valeurs par defaut : Gmail)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# MAIL_FROM=votre.adresse@gmail.com

# Bouton "Continuer avec Google" (Google Cloud > API et services > Identifiants >
# ID client OAuth, type "Application Web"). L'URI de redirection declaree chez
# Google doit etre exactement GOOGLE_REDIRECT_URI.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Affiche le code dans la page (tests locaux). Sans SMTP, actif par defaut hors
# production ; avec SMTP, inactif. Ne jamais mettre 1 sur un serveur public.
# AUTH_EXPOSE_OTP=1
# Connexion par mot de passe : echecs autorises par e-mail, puis duree du blocage (ms).
# LOGIN_MAX_ATTEMPTS=5
# LOGIN_LOCK_WINDOW_MS=900000
# SESSION_COOKIE_NAME=vcard_sid
