{
  "name": "evc-melissa",
  "version": "1.0.0",
  "description": "EVC Melissa — generateur de carte de visite numerique et QR Code dynamique avec backend SQLite",
  "main": "backend/server.js",
  "scripts": {
    "start": "node --no-warnings backend/server.js",
    "dev": "node --no-warnings --watch backend/server.js",
    "test": "node --test tests/test-auth.js tests/test-admin.js",
    "admin:install": "npm install --prefix admin",
    "admin:build": "npm run build --prefix admin",
    "admin:dev": "npm run dev --prefix admin"
  },
  "engines": {
    "node": ">=22.5.0"
  }
}

